# ============================================================
# OperadorApp — Variables de entorno
# Copiar este archivo como .env y completar los valores.
# NUNCA commitear .env al repositorio.
# ============================================================

# URL de Supabase
# - Local:      http://localhost:54321
# - Producción: https://<project-ref>.supabase.co
SUPABASE_URL=http://10.0.2.2:54321

# Clave anónima de Supabase (segura para exponer en el cliente)
# Obtener de: supabase status (local) o Supabase Dashboard > Settings > API
SUPABASE_ANON_KEY=<tu_publishable_key_de_supabase_status>

# Proveedor de mapas
# Opciones: osm (OpenStreetMap, sin costo, default en dev)
#           google (Google Maps, requiere API key y facturación)
MAP_PROVIDER=osm

# API Key de Google Maps (solo necesaria si MAP_PROVIDER=google)
# Obtener de: Google Cloud Console > Maps SDK for Android/iOS
GOOGLE_MAPS_API_KEY=
